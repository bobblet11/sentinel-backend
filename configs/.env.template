# =====================================================
# Sentinel Docker Compose - Complete Environment File
# Copy this to .env and customize as needed
# =====================================================

# --- Ntfy streams ---
CRITICAL_NOTIFICATION_STREAM=critical_stream_name
WARNING_NOTIFICATION_STREAM=warning_stream_name

# --- Docker & Profiles ---
COMPOSE_FILE=./docker/compose/docker-compose.yml
COMPOSE_PROFILES=ingestor,scraper,nlp-gpu,retrieval-gpu
PYTHONUNBUFFERED=1

# --- Infrastructure ---

# --- Local Redis ---
# Redis running locally through a container. Use local profile
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_SSL=false
# REDIS_CPU_LIMIT=1.5
# REDIS_MEMORY_LIMIT=4G
# REDIS_CPU_RESERVATION=1.0
# REDIS_MEMORY_RESERVATION=2G

# --- AWS Redis ---
# Redis via ElastiCache over an SSH tunnel running on the host machine. Don't use local profile
# Keep the tunnel bound to localhost:6379 on the host and let containers reach it via host.docker.internal.
# ElastiCache has transit encryption required, so Redis clients must use TLS through the tunnel.
# 	ssh -i virginia-porpan-mbp.pem -o ExitOnForwardFailure=yes -N -L 16379:your-elasticache-endpoint:6379 ubuntu@your-ec2-jump-host -v

REDIS_HOST=host.docker.internal
REDIS_PORT=16379
REDIS_SSL=true
REDIS_SSL_CERT_REQS=none
REDIS_EXTERNAL_PORT=6380


# PostgreSQL  

# --- Local Postgres ---
# Postgres running locally through a container. Use local profile
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_EXTERNAL_PORT=15432
# POSTGRES_DB=sentinel
# POSTGRES_USER=sentinel
# POSTGRES_PASSWORD=sentinelpass
# POSTGRES_SSLMODE=disable
# POSTGRES_HOST_AUTH_METHOD=md5
# POSTGRES_CPU_LIMIT=1.0
# POSTGRES_MEMORY_LIMIT=2G
# POSTGRES_CPU_RESERVATION=0.5
# POSTGRES_MEMORY_RESERVATION=1G

# --- AWS Posgres ---
# PostgreSQL — RDS via SSH tunnel through the EC2 jump host.
# Each developer runs the tunnel on their machine:
#	ssh -i virginia-porpan-mbp.pem -f -N -L 15433:your-rds-endpoint:5432 ubuntu@your-ec2-jump-host
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=15433	
POSTGRES_SSLMODE=require
POSTGRES_EXTERNAL_PORT=15432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-rds-password-here
POSTGRES_HOST_AUTH_METHOD=md5


# --- Services & Streams ---
# API Service
API_SERVICE_PORT=8001
API_OUTPUT_STREAM=user:to.be.scraped
API_CPU_LIMIT=0.5
API_MEMORY_LIMIT=512M
API_CPU_RESERVATION=0.25
API_MEMORY_RESERVATION=256M

# Ingestor Service
INGESTOR_REDIS_DUPLICATE_FILTER_KEY=ingestor:seen.articles
INGESTOR_OUTPUT_STREAM=background:to.be.scraped
INGESTOR_MAX_WORKERS=10
INGESTOR_CPU_LIMIT=0.5
INGESTOR_MEMORY_LIMIT=512M
INGESTOR_CPU_RESERVATION=0.25
INGESTOR_MEMORY_RESERVATION=256M

# Web Scraper Service
WEB_SCRAPER_INPUT_STREAMS=user:to.be.scraped,background:to.be.scraped
WEB_SCRAPER_USER_OUTPUT_STREAM=user:to.be.nlp
WEB_SCRAPER_BACKGROUND_OUTPUT_STREAM=background:to.be.nlp
WEB_SCRAPER_FAILURE_OUTPUT_STREAM=failure:to.be.scraped
WEB_SCRAPER_GROUP_NAME=default
WEB_SCRAPER_CONSUMER_NAME=farhan-web-scraper-1
WEB_SCRAPER_LOG_MODE=10
WEB_SCRAPER_SHM_SIZE=4gb
WEB_SCRAPER_BATCH_SIZE=10
WEB_SCRAPER_MAX_WORKERS=2
WEB_SCRAPER_MAX_FETCH_RETRIES=3
WEB_SCRAPER_INITIAL_FETCH_DELAY_S=1
WEB_SCRAPER_FETCH_DELAY_GROWTH_RATE=1.2
WEB_SCRAPER_CPU_LIMIT=1.0
WEB_SCRAPER_MEMORY_LIMIT=2G
WEB_SCRAPER_CPU_RESERVATION=0.5
WEB_SCRAPER_MEMORY_RESERVATION=1G
MAX_SCREENSHOT_FOLDER_SIZE=10000000

# NLP Service
NLP_INPUT_STREAMS=user:to.be.nlp,background:to.be.nlp
NLP_USER_OUTPUT_STREAM=user:to.be.retrieval
NLP_BACKGROUND_OUTPUT_STREAM=background:to.be.retrieval
NLP_FAILURE_OUTPUT_STREAM=failure:to.be.nlp
NLP_GROUP_NAME=default
NLP_CONSUMER_NAME=farhan-nlp-1
NLP_BATCH_SIZE=10
NLP_MAX_WORKERS=2
NLP_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
NLP_NER_MODEL=dslim/bert-base-NER-uncased
NLP_BIAS_MODEL=premsa/political-bias-prediction-allsides-BERT
NLP_SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
NLP_QG_MODEL=Salesforce/mixqg-base
NLP_QA_MODEL=deepset/roberta-base-squad2
NLP_GEN_MODEL=google/flan-t5-base
HF_HOME=/opt/sentinel/models/huggingface
TRANSFORMERS_CACHE=/opt/sentinel/models/huggingface
NLP_SHM_SIZE=4gb
NLP_CPU_LIMIT=1.0
NLP_MEMORY_LIMIT=6G
NLP_CPU_RESERVATION=0.5
NLP_MEMORY_RESERVATION=2G

# Retrieval Layer
RETRIEVAL_INPUT_STREAMS=user:to.be.retrieval,background:to.be.retrieval
RETRIEVAL_FAILURE_OUTPUT_STREAM=failure:to.be.retrieval
RETRIEVAL_GROUP_NAME=default
RETRIEVAL_CONSUMER_NAME=farhan-retrieval-1
RETRIEVAL_BATCH_SIZE=10
RETRIEVAL_CPU_LIMIT=1.0
RETRIEVAL_MEMORY_LIMIT=2G
RETRIEVAL_CPU_RESERVATION=0.5
RETRIEVAL_MEMORY_RESERVATION=1G
RETRIEVAL_LAYER_SHM_SIZE=1gb
HASH_STORE_NAMESPACE=retrieval:hash.store
RETRIEVAL_DUMMY_NLP_MODE=False
RETRIEVAL_DUMMY_SEED_MODE=False
RETRIEVAL_RETRY_FAILURE_MODE=True
# --- Secrets & External Services ---
GITHUB_USER=boblet11
GITHUB_EMAIL=your-email@example.com
WEBSHARIO_URL=https://proxy.webshare.io/api/v2/proxy/list/download/REDACTED/-/any/username/backbone/-/?plan_id=YOUR-PLAN-ID

