# .env.template
# This file is a template for the required environment variables.
# Copy this file to .env and fill in the values for your local development.

# --- Docker Settings ---
COMPOSE_FILE=./docker/compose/docker-compose.yml
PYTHONUNBUFFERED=1

# --- Redis Configuration ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- PostgreSQL Configuration ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- API Service Configuration ---
API_SERVICE_PORT=8001

# --- Github Credentials (Example, if needed by your build process) ---
GITHUB_USER=
GITHUB_EMAIL=

# --- Proxies (Secrets) ---
# URL for downloading the proxy list
WEBSHARIO_URL=

# --- Profiles to run ---
COMPOSE_PROFILES=ingestor,api,scraper-prioritiser,scraper,nlp-prioritiser,nlp

# ===============================================================
# --- PERFORMANCE TUNING & RESOURCE ALLOCATION ---
# These are default values. You can create different .env files
# for different performance profiles (e.g., .env.benchmark).
# ===============================================================

# --- Infrastructure Resources ---
# Format: '0.5' for half a core, '1.0' for one core
REDIS_CPU_LIMIT=0.5
# Format: '512M' for megabytes, '1G' for gigabytes
REDIS_MEMORY_LIMIT=512M
REDIS_CPU_RESERVATION=0.25
REDIS_MEMORY_RESERVATION=256M

POSTGRES_CPU_LIMIT=1.0
POSTGRES_MEMORY_LIMIT=2G
POSTGRES_CPU_RESERVATION=0.5
POSTGRES_MEMORY_RESERVATION=1G

# --- API Service Resources ---
API_CPU_LIMIT=0.5
API_MEMORY_LIMIT=512M
API_CPU_RESERVATION=0.25
API_MEMORY_RESERVATION=256M

# --- Ingestor Service ---
# Number of concurrent workers for the ingestor
INGESTOR_MAX_WORKERS=10
INGESTOR_CPU_LIMIT=0.5
INGESTOR_MEMORY_LIMIT=512M
INGESTOR_CPU_RESERVATION=0.25
INGESTOR_MEMORY_RESERVATION=256M

# --- Scraper Prioritiser Service ---
# Number of messages to process in a batch
SCRAPER_PRIORITISER_BATCH_SIZE=100
# Number of workers for publishing results
SCRAPER_PRIORITISER_MAX_PUBLISH_WORKERS=10
PRIORITISER_CPU_LIMIT=0.5
PRIORITISER_MEMORY_LIMIT=512M
PRIORITISER_CPU_RESERVATION=0.25
PRIORITISER_MEMORY_RESERVATION=256M

# --- Web Scraper Service ---
# Shared memory size for the browser instances
WEB_SCRAPER_SHM_SIZE=4gb
# Number of URLs to scrape in a batch
WEB_SCRAPER_BATCH_SIZE=10
# Number of concurrent scraper browser instances
WEB_SCRAPER_MAX_WORKERS=2
# Number of workers to validate proxies
WEB_SCRAPER_MAX_PROXY_VALIDATION_WORKERS=100
# Max retries for fetching a URL
WEB_SCRAPER_MAX_FETCH_RETRIES=3
# Initial delay in seconds before retrying a failed fetch
WEB_SCRAPER_INITIAL_FETCH_DELAY_S=1
# Multiplier for increasing the fetch delay on subsequent retries
WEB_SCRAPER_FETCH_DELAY_GROWTH_rate=1.2
WEB_SCRAPER_CPU_LIMIT=1.0
WEB_SCRAPER_MEMORY_LIMIT=2G
WEB_SCRAPER_CPU_RESERVATION=0.5
WEB_SCRAPER_MEMORY_RESERVATION=1G
