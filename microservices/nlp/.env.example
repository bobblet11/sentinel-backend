# ------------------------------
# Service Identity & Logging
# ------------------------------
ENV=development
LOG_LEVEL=INFO

# ------------------------------
# Hardware & Performance
# ------------------------------
# Device to run models on: "cpu", "cuda" (NVIDIA), or "mps" (Mac Silicon)
INFERENCE_DEVICE=cuda
# Number of samples to process at once
BATCH_SIZE=32
# Directory to cache downloaded HuggingFace models (prevents redownloading)
HF_HOME=./.cache/huggingface

# ------------------------------
# Model Registry (HuggingFace IDs or Local Paths)
# ------------------------------
# Named Entity Recognition
MODEL_NER=dslim/bert-base-ner
# Bias Detection
MODEL_BIAS=valurank/distilroberta-bias
# Vector Embeddings (for PGVector)
MODEL_EMBEDDINGS=sentence-transformers/all-MiniLM-L6-v2

# ------------------------------
# Logic Thresholds
# ------------------------------
# Minimum confidence to flag a sentence as biased (0.0 - 1.0)
THRESHOLD_BIAS=0.70
# Minimum confidence to flag text as checkworthy (0.0 - 1.0)
THRESHOLD_CHECKWORTHY=0.60