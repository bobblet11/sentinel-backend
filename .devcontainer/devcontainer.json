{
        "name": "Sentinel (Anaconda) Dev Environment",
        "build": {
                "dockerfile": "Dockerfile"
        },
        "mounts": [
                "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
        ],
        "customizations": {
                "vscode": {
                        "settings": {
                                "python.defaultInterpreterPath": "/opt/conda/envs/sentinel-env/bin/python",
                                "python.linting.pylintEnabled": true,
                                "python.linting.enabled": true
                        },
                        "extensions": [
                                "ms-python.python",
                                "ms-python.vscode-pylance",
                                "ms-azuretools.vscode-docker",
                                "eamodio.gitlens"
                        ]
                }
        },
        "remoteUser": "vscode",
        "remoteEnv": {
                "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}"
        },
        "initializeCommand": [
  "sh",
  "-c",
  "docker network inspect sentinel-net >/dev/null 2>&1 || docker network create sentinel-net"],
    "postCreateCommand": "docker network connect sentinel-net \"$(docker inspect -f '{{.Id}}' $(hostname))\""

}
