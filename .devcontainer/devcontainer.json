{
        "name": "Sentinel (Anaconda) Dev Environment",
        "build": {
                "dockerfile": "Dockerfile"
        },
        "mounts": [
                "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
        ],
        "customizations": {
                "vscode": {
                        "settings": {
                                "python.defaultInterpreterPath": "/opt/conda/envs/sentinel-env/bin/python",
                                "python.linting.pylintEnabled": true,
                                "python.linting.enabled": true
                        },
                        "extensions": [
                                "ms-python.python",
                                "ms-python.vscode-pylance",
                                "ms-azuretools.vscode-docker",
   rying                              "eamodio.gitlens"
                        ]
                }
        },
        "remoteUser": "vscode",
        "remoteEnv": {
                "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}"
        },
        "initializeCommand": ["powershell", "-Command", "docker network inspect sentinel-net 2>$null; if ($LASTEXITCODE -ne 0) { docker network create sentinel-net }"],
        "runArgs": ["--network=sentinel-net"]

}
